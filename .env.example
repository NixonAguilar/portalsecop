# Copia este archivo a `.env` y completa los valores.
# Obtén un App Token gratuito en: https://evergreen.data.socrata.com/signup
VITE_SOCRATA_APP_TOKEN=tu_app_token_aqui
VITE_SECOP_II_ENDPOINT=https://www.datos.gov.co/resource/p6dx-8zbt.json
VITE_SECOP_I_ENDPOINT=https://www.datos.gov.co/resource/f789-7hwg.json

# Supabase (autenticación + perfiles de usuario)
# Obtén estos valores en: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_public_key
